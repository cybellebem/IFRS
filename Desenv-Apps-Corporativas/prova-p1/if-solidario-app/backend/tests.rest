############################################
# EVENTOS
############################################

### Listar eventos
GET {{baseUrl}}/events

### Detalhar evento com voluntários
GET {{baseUrl}}/events/1

### Evento inexistente
GET {{baseUrl}}/events/999

### Criar evento
# @name createEvent
POST {{baseUrl}}/events
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Mutirão de Plantio",
  "descricao": "Plantio de mudas nativas no entorno do campus.",
  "data": "2026-12-05",
  "local": "IFRS Campus Bento Gonçalves",
  "maximo_voluntarios": 2
}

### Criar evento com dados inválidos
POST {{baseUrl}}/events
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "",
  "data": "05/12/2026",
  "maximo_voluntarios": 0
}

### Atualizar evento
PUT {{baseUrl}}/events/5
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Mutirão de Plantio (atualizado)",
  "descricao": "Plantio de mudas nativas e limpeza da área.",
  "data": "2026-12-06",
  "local": "IFRS Campus Bento Gonçalves",
  "maximo_voluntarios": 2
}

### Inscrever voluntário 1 no novo evento
POST {{baseUrl}}/events/5/volunteers
Authorization: Bearer {{token}}
Content-Type: application/json

{ "voluntario_id": 1 }

### Inscrever voluntário 2 — evento fica lotado
POST {{baseUrl}}/events/5/volunteers
Authorization: Bearer {{token}}
Content-Type: application/json

{ "voluntario_id": 2 }

### Inscrever voluntário 3 — limite atingido
POST {{baseUrl}}/events/5/volunteers
Authorization: Bearer {{token}}
Content-Type: application/json

{ "voluntario_id": 3 }

### Inscrição duplicada
POST {{baseUrl}}/events/5/volunteers
Authorization: Bearer {{token}}
Content-Type: application/json

{ "voluntario_id": 1 }

### Reduzir limite abaixo dos inscritos
PUT {{baseUrl}}/events/5
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Mutirão de Plantio",
  "descricao": "Plantio de mudas nativas.",
  "data": "2026-12-06",
  "local": "IFRS Campus Bento Gonçalves",
  "maximo_voluntarios": 1
}

### Cancelar inscrição do voluntário 2
DELETE {{baseUrl}}/events/5/volunteers/2
Authorization: Bearer {{token}}

### Excluir evento
DELETE {{baseUrl}}/events/5
Authorization: Bearer {{token}}

